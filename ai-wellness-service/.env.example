# ===========================================================================
# Minimal Environment Variables (.env)
# ===========================================================================
# Copy this file to .env
# Only 2 values are mandatory for local startup!
# ===========================================================================

# 1. MUST BE SET: Your MySQL Database Password
DB_PASSWORD=Mathan@2005

# 2. MUST BE SET: JWT Secret Key (Must be at least 64 characters long)
JWT_SECRET=super_secret_jwt_key_that_is_at_least_64_characters_long_for_security_123456789

# 3. OPTIONAL: Google Gemini API Key (Required when using AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# All other settings below have default values in application.properties!
# Uncomment ONLY if you want to change default ports or URLs.
# ---------------------------------------------------------------------------
# DB_URL=jdbc:mysql://localhost:3306/wellness?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
# DB_USERNAME=wellness_user
# SERVER_PORT=8080
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
